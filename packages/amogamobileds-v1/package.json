{
  "name": "amogamobileds-v1",
  "version": "1.0.0",
  "description": "Amoga Mobile UI Design System & Component Library for Expo and React Native",
  "main": "expo-router/entry",
  "types": "./index.ts",
  "module": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./ui": {
      "types": "./components/ui/index.ts",
      "import": "./components/ui/index.ts",
      "default": "./components/ui/index.ts"
    },
    "./chat": {
      "types": "./components/chat/index.ts",
      "import": "./components/chat/index.ts",
      "default": "./components/chat/index.ts"
    },
    "./providers": {
      "types": "./providers/index.ts",
      "import": "./providers/index.ts",
      "default": "./providers/index.ts"
    },
    "./theme": {
      "types": "./theme/index.ts",
      "import": "./theme/index.ts",
      "default": "./theme/index.ts"
    },
    "./hooks": {
      "types": "./hooks/index.ts",
      "import": "./hooks/index.ts",
      "default": "./hooks/index.ts"
    },
    "./lib": {
      "types": "./lib/index.ts",
      "import": "./lib/index.ts",
      "default": "./lib/index.ts"
    }
  },
  "files": [
    "components",
    "providers",
    "theme",
    "hooks",
    "lib",
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "lint": "expo lint",
    "test": "jest",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:diff": "npx supabase db diff -f",
    "db:types": "npx supabase gen types typescript --linked > lib/database.types.ts",
    "db:types:local": "npx supabase gen types typescript --local > lib/database.types.ts",
    "functions:serve": "npx supabase functions serve",
    "functions:deploy": "npx supabase functions deploy"
  },
  "dependencies": {
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.111.0",
    "aes-js": "^3.1.2",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.5",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.16",
    "expo-media-library": "~57.0.3",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-svg": "*"
  }
}
