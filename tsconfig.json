{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@ds/*": ["./packages/amogamobileds-v1/*", "../amogamobileds-v1/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "packages/amogamobileds-v1/index.ts",
    "packages/amogamobileds-v1/components/**/*.ts",
    "packages/amogamobileds-v1/components/**/*.tsx",
    "packages/amogamobileds-v1/hooks/**/*.ts",
    "packages/amogamobileds-v1/hooks/**/*.tsx",
    "packages/amogamobileds-v1/providers/**/*.ts",
    "packages/amogamobileds-v1/providers/**/*.tsx",
    "packages/amogamobileds-v1/theme/**/*.ts",
    "packages/amogamobileds-v1/theme/**/*.tsx",
    "packages/amogamobileds-v1/lib/**/*.ts",
    "packages/amogamobileds-v1/lib/**/*.tsx",
    "packages/amogamobileds-v1/declarations.d.ts",
    "../amogamobileds-v1/index.ts",
    "../amogamobileds-v1/components/**/*.ts",
    "../amogamobileds-v1/components/**/*.tsx",
    "../amogamobileds-v1/hooks/**/*.ts",
    "../amogamobileds-v1/hooks/**/*.tsx",
    "../amogamobileds-v1/providers/**/*.ts",
    "../amogamobileds-v1/providers/**/*.tsx",
    "../amogamobileds-v1/theme/**/*.ts",
    "../amogamobileds-v1/theme/**/*.tsx",
    "../amogamobileds-v1/lib/**/*.ts",
    "../amogamobileds-v1/lib/**/*.tsx",
    "../amogamobileds-v1/declarations.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "../amogamobileds-v1/node_modules/**",
    "../amogamobileds-v1/app/**",
    "../amogamobileds-v1/supabase/**",
    "**/supabase/functions/**"
  ]
}
